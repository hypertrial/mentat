#!/usr/bin/env bash
# Run as root only on the dedicated Ubuntu 24.04 ARM64 worker.
set -euo pipefail
[[ $(id -u) == 0 && $(uname -m) == aarch64 ]] || { echo 'Requires a root-owned ARM64 worker' >&2; exit 1; }
: "${MENTAT_BASELINE_PROJECT:?trusted baseline project required}"
: "${MENTAT_BASELINE_LOCK:?trusted baseline lock required}"
: "${MENTAT_BASELINE_PROJECT_SHA256:?baseline digest required}"
: "${MENTAT_BASELINE_LOCK_SHA256:?baseline digest required}"
: "${MENTAT_PROVISIONER_SHA256:?trusted provisioner digest required}"
: "${MENTAT_PY314_REQUIREMENTS:?trusted Python requirements required}"
: "${MENTAT_NPM_MANIFEST:?trusted npm manifest required}"
: "${MENTAT_NPM_LOCK:?trusted npm lock required}"
: "${MENTAT_PY314_REQUIREMENTS_SHA256:?trusted Python digest required}"
: "${MENTAT_NPM_MANIFEST_SHA256:?trusted npm digest required}"
: "${MENTAT_NPM_LOCK_SHA256:?trusted npm digest required}"
[[ ! -e /opt/mentat-tools ]] || { echo 'Refusing to replace /opt/mentat-tools' >&2; exit 1; }
mkdir -m 755 /opt/mentat-tools
ok=0
cleanup() { if [[ $ok != 1 ]]; then rm -rf -- /opt/mentat-tools; fi; }
trap cleanup EXIT
root=/opt/mentat-tools
mkdir -p "$root/baseline" "$root/python" "$root/cache" "$root/bin" "$root/downloads" "$root/node" "$root/node-tools"
printf '%s' "$MENTAT_BASELINE_PROJECT" | base64 -d > "$root/baseline/pyproject.toml"
printf '%s' "$MENTAT_BASELINE_LOCK" | base64 -d > "$root/baseline/uv.lock"
printf '%s  %s\n' "$MENTAT_BASELINE_PROJECT_SHA256" "$root/baseline/pyproject.toml" | sha256sum -c -
printf '%s  %s\n' "$MENTAT_BASELINE_LOCK_SHA256" "$root/baseline/uv.lock" | sha256sum -c -
for entry in PY314_REQUIREMENTS:requirements-314.txt NPM_MANIFEST:package.json NPM_LOCK:package-lock.json; do
  key=${entry%%:*}; file=${entry#*:}; value=MENTAT_$key; digest=MENTAT_${key}_SHA256
  printf '%s' "${!value}" | base64 -d > "$root/node-tools/$file"
  printf '%s  %s\n' "${!digest}" "$root/node-tools/$file" | sha256sum -c -
done
apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates curl git xz-utils libatomic1
# Digests: GitHub uv 0.11.13 release asset and Node 26.10.0 official SHASUMS.
curl --fail --silent --show-error --location --retry 3 --proto '=https' --tlsv1.2 \
  https://github.com/astral-sh/uv/releases/download/0.11.13/uv-aarch64-unknown-linux-gnu.tar.gz -o "$root/downloads/uv.tar.gz"
printf '%s  %s\n' 12366407dc1fdba5179b10bd69c11ebfc2eff25791366089c0b2f5701056efc5 "$root/downloads/uv.tar.gz" | sha256sum -c -
tar -xzf "$root/downloads/uv.tar.gz" -C "$root/downloads"
install -m 755 "$root/downloads/uv-aarch64-unknown-linux-gnu/uv" "$root/bin/uv"
curl --fail --silent --show-error --location --retry 3 --proto '=https' --tlsv1.2 \
  https://nodejs.org/dist/v26.10.0/node-v26.10.0-linux-arm64.tar.xz -o "$root/downloads/node.tar.xz"
printf '%s  %s\n' 7a6353f63eb3d04765004b4adf172616243e4522434635cb1d26288658b04ab5 "$root/downloads/node.tar.xz" | sha256sum -c -
tar -xJf "$root/downloads/node.tar.xz" --strip-components=1 -C "$root/node"
export PATH="$root/bin:$root/node/bin:/usr/bin:/bin"
export UV_PYTHON_INSTALL_DIR="$root/python" UV_CACHE_DIR="$root/cache" PLAYWRIGHT_BROWSERS_PATH="$root/browsers"
uv python install 3.12 3.14
uv venv --python "$(uv python find 3.14)" "$root/.venv-3.14"
uv pip install --python "$root/.venv-3.14/bin/python" --no-deps -r "$root/node-tools/requirements-314.txt"
npm ci --prefix "$root/node-tools" --ignore-scripts --no-audit --no-fund
UV_PROJECT_ENVIRONMENT="$root/.venv" uv sync --project "$root/baseline" --locked --extra polaris --no-install-project
uv pip install --python "$root/.venv/bin/python" 'playwright==1.65.2' 'hatchling==1.29.0'
"$root/.venv/bin/python" -m playwright install --with-deps chromium
browser=$("$root/.venv/bin/python" -c 'from playwright.sync_api import sync_playwright; p=sync_playwright().start(); print(p.chromium.executable_path); p.stop()')
[[ -x "$browser" ]] || { echo 'Chromium installation unavailable' >&2; exit 1; }
ln -s "$browser" "$root/bin/chromium"
ln -s "$(uv python find 3.14)" "$root/bin/python3.14"
"$root/.venv/bin/python" -c 'import sys; assert sys.version_info[:2] == (3, 12); import pytest, z3, typer, rich, hypothesis, hatchling, playwright'
"$root/.venv-3.14/bin/python" -c 'import sys; assert sys.version_info[:2] == (3, 14); import coverage, greenlet, hatchling, packaging, pathspec, playwright, pluggy, trove_classifiers, typing_extensions'
NODE_PATH="$root/node-tools/node_modules" "$root/node/bin/node" -e 'for (const p of ["istanbul-lib-coverage", "istanbul-lib-instrument", "istanbul-lib-report", "istanbul-reports"]) require(p)'
"$root/bin/uv" --version
"$root/node/bin/node" --version
"$root/bin/chromium" --version
rm -rf -- "$root/downloads"
python3 - "$root/profile.json" <<'PY'
import json, os, sys
with open(sys.argv[1], 'w', encoding='utf-8') as f:
    json.dump({'pyproject_sha256': os.environ['MENTAT_BASELINE_PROJECT_SHA256'],
               'uv_lock_sha256': os.environ['MENTAT_BASELINE_LOCK_SHA256'],
               'provisioner_sha256': os.environ['MENTAT_PROVISIONER_SHA256'],
               'py314_requirements_sha256': os.environ['MENTAT_PY314_REQUIREMENTS_SHA256'],
               'npm_manifest_sha256': os.environ['MENTAT_NPM_MANIFEST_SHA256'],
               'npm_lock_sha256': os.environ['MENTAT_NPM_LOCK_SHA256']}, f, sort_keys=True)
    f.write('\n')
PY
chown -R root:root "$root"
chmod -R go-w "$root"
ok=1
